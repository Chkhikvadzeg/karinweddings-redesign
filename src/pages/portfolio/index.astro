---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import EnquiryCta from '../../components/EnquiryCta.astro';
import { galleries } from '../../data/galleries';
import { photo } from '../../lib/images';
import { url } from '../../lib/url';

const weddings = galleries.filter((g) => g.kind === 'Wedding');
const other = galleries.filter((g) => g.kind !== 'Wedding');
---

<Base
  title="Portfolio — every wedding | Karin Weddings & Events"
  description={`${weddings.length} weddings, engagements and celebrations planned by Karin Čemažar across Slovenia.`}
>
  <section class="phead">
    <div class="shell">
      <p class="eyebrow">Portfolio</p>
      <h1 class="phead__title">{galleries.length} days, so far</h1>
      <p class="lead">
        Every wedding, engagement and celebration with a gallery on this site — {weddings.length}
        weddings and {other.length} other days. Real couples, real names, in their own order.
      </p>
    </div>
  </section>

  <section class="section pgrid-wrap">
    <div class="shell">
      <div class="pgrid">
        {
          galleries.map((g, i) => (
            <article class="gcard" data-reveal data-reveal-delay={(i % 6) * 60}>
              <a class="gcard__link" href={url(`/portfolio/${g.slug}/`)}>
                <div class="gcard__img">
                  <Pic
                    src={photo(g.cover)}
                    alt=""
                    decorative
                    widths={[400, 800]}
                    sizes="(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 30vw"
                  />
                  {g.kind !== 'Wedding' && <span class="gcard__kind">{g.kind}</span>}
                </div>
                <h2 class="gcard__title">{g.title}</h2>
                <p class="gcard__count">{g.photos.length} photographs</p>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <EnquiryCta heading="Yours is the next one" />
</Base>

<style>
  .phead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  .phead__title {
    font-size: var(--fs-display);
    margin-bottom: 1.25rem;
  }

  .pgrid-wrap {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .gcard__link {
    display: block;
    text-decoration: none;
  }

  .gcard__img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 0.9rem;
    background: var(--paper-deep);
  }

  .gcard__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .gcard__link:hover .gcard__img :global(img) {
    transform: scale(1.04);
  }

  .gcard__kind {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: var(--paper);
    color: var(--terracotta);
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
  }

  .gcard__title {
    font-size: 1.25rem;
    margin-bottom: 0.2rem;
  }

  .gcard__count {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0;
  }

  @media (max-width: 1100px) {
    .pgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .pgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
