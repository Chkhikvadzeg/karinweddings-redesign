---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import EnquiryCta from '../../components/EnquiryCta.astro';
import { services } from '../../data/services';
import { process } from '../../data/process';
import { photo } from '../../lib/images';
import { url } from '../../lib/url';

// One template, four pages.
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
---

<Base
  title={`${service.name} — Karin Weddings & Events`}
  description={`${service.tagline} ${service.name} in Slovenia from €${service.priceFrom.toLocaleString('en-GB')}.`}
>
  <section class="shero">
    <div class="shell shero__shell">
      <div class="shero__type">
        <p class="eyebrow">Service</p>
        <h1 class="shero__title">{service.name}</h1>
        <p class="shero__tagline script">{service.tagline}</p>

        <dl class="shero__meta">
          <div>
            <dt>Best for</dt>
            <dd>{service.bestFor}</dd>
          </div>
          <div>
            <dt>From</dt>
            <dd>€{service.priceFrom.toLocaleString('en-GB')}</dd>
          </div>
        </dl>
        <p class="shero__note">{service.priceNote}</p>

        <a class="btn shero__cta" href={url(`/enquire/?for=${service.slug}`)}>
          Ask about {service.name}
        </a>
      </div>

      <figure class="shero__figure">
        <Pic
          src={photo(service.photo)}
          alt={`${service.name} — a wedding planned by Karin`}
          widths={[560, 1000, 1400]}
          sizes="(max-width: 900px) 100vw, 46vw"
          priority
        />
      </figure>
    </div>
  </section>

  <!-- ── What this covers, mapped onto the same process ──────────────── -->
  <section class="band band--deep section covers">
    <div class="shell">
      <p class="eyebrow" data-reveal>What this covers</p>
      <ol class="covers__list" data-reveal data-reveal-delay="80">
        {
          process.map((step) => {
            const on = service.covers.includes(step.id);
            return (
              <li class:list={['cstep', { 'cstep--on': on }]}>
                <span class="cstep__mark" aria-hidden="true">{on ? '●' : '○'}</span>
                <span class="cstep__when">{step.when}</span>
                <span class="cstep__title">{step.title}</span>
                <span class="cstep__state">{on ? 'Included' : 'Not in this package'}</span>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- ── Body + includes ─────────────────────────────────────────────── -->
  <section class="section sbody">
    <div class="shell sbody__shell">
      <div class="sbody__prose" data-reveal>
        {service.body.map((p) => <p>{p}</p>)}
      </div>

      <div class="sbody__includes" data-reveal data-reveal-delay="120">
        <p class="eyebrow">Everything included</p>
        <ul class="includes">
          {
            service.includes.map((item) => (
              <li>
                <span class="includes__tick" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Other services ──────────────────────────────────────────────── -->
  <section class="band band--deep section sothers">
    <div class="shell">
      <p class="eyebrow" data-reveal>Or something else</p>
      <ul class="sothers__list">
        {
          others.map((s, i) => (
            <li data-reveal data-reveal-delay={i * 70}>
              <a href={url(`/services/${s.slug}/`)}>
                <span class="sothers__name">{s.name}</span>
                <span class="sothers__tag">{s.tagline}</span>
                <span class="sothers__price">from €{s.priceFrom.toLocaleString('en-GB')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <EnquiryCta context={service.slug} heading="Is your date free?" />
</Base>

<style>
  .shero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    overflow: hidden;
  }

  .shero__shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-right: 0;
  }

  .shero__title {
    font-size: var(--fs-display);
    margin-bottom: 0.85rem;
  }

  .shero__tagline {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    color: var(--fg);
    margin-bottom: 2.25rem;
  }

  .shero__meta {
    display: flex;
    gap: clamp(2rem, 4vw, 3.5rem);
    margin: 0 0 0.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--rule);
  }

  .shero__meta dt {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.35rem;
    font-weight: 600;
  }

  .shero__meta dd {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
  }

  .shero__note {
    font-size: var(--fs-small);
    color: var(--ink-faint);
    font-style: italic;
    margin-bottom: 2rem;
  }

  .shero__figure {
    margin: 0;
    margin-right: calc(var(--gutter) * -1);
    aspect-ratio: 1 / 1.05;
    overflow: hidden;
    border-radius: 4px 0 0 4px;
  }

  .shero__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .shero__shell {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .shero__figure {
      order: -1;
      margin-inline: calc(var(--gutter) * -1);
      aspect-ratio: 4 / 3.2;
      border-radius: 0;
    }
  }

  /* ── Coverage map ─────────────────────────────────────────────────── */
  .covers__list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .cstep {
    display: grid;
    grid-template-columns: 1.5rem 9rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-faint);
  }

  .cstep--on {
    color: var(--fg);
  }

  .cstep__mark {
    color: var(--ink-faint);
    font-size: 0.75rem;
  }

  .cstep__when {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cstep__title {
    font-family: var(--display);
    font-size: 1.0625rem;
  }

  .cstep__state {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    justify-self: end;
  }

  .cstep--on .cstep__state {
    color: var(--fg);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .cstep {
      grid-template-columns: 1.25rem 1fr;
      gap: 0.25rem 0.75rem;
    }
    .cstep__when {
      grid-column: 2;
    }
    .cstep__title {
      grid-column: 2;
    }
    .cstep__state {
      grid-column: 2;
      justify-self: start;
    }
  }

  /* ── Body ─────────────────────────────────────────────────────────── */
  .sbody__shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .sbody__prose p {
    font-family: var(--display);
    font-size: clamp(1.1875rem, 1.9vw, 1.5rem);
    line-height: 1.45;
    max-width: 32rem;
  }

  .sbody__prose p + p {
    font-family: var(--sans);
    font-size: var(--fs-body);
    line-height: 1.66;
    color: var(--ink-soft);
  }

  .includes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .includes li {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.7rem;
    align-items: start;
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .includes li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .includes__tick {
    width: 1.4rem;
    height: 1.4rem;
    position: relative;
  }

  .includes__tick::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 0.6rem;
    height: 0.32rem;
    border-left: 1.5px solid var(--fg);
    border-bottom: 1.5px solid var(--fg);
    transform: rotate(-45deg);
  }

  @media (max-width: 900px) {
    .sbody__shell {
      grid-template-columns: 1fr;
    }
  }

  /* ── Other services ───────────────────────────────────────────────── */
  .sothers__list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .sothers__list li {
    border-bottom: 1px solid var(--rule);
  }

  .sothers__list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.35rem;
    text-decoration: none;
    transition: padding-inline var(--m-move) var(--ease);
  }

  .sothers__list a:hover {
    padding-inline: 0.85rem;
  }

  .sothers__name {
    font-family: var(--display);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
  }

  .sothers__tag {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .sothers__price {
    font-size: var(--fs-small);
    color: var(--fg);
    font-weight: 600;
    white-space: nowrap;
    justify-self: end;
  }

  @media (max-width: 760px) {
    .sothers__list a {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .sothers__price {
      justify-self: start;
    }
  }
</style>
