---
import Pic from './Pic.astro';
import { photo } from '../lib/images';
import { url } from '../lib/url';
import { site } from '../data/site';
import heroWide from '../assets/gen/hero-wide.png';

/**
 * Hero as a single typographic statement, bottom-left anchored, with the
 * photograph as a full-bleed slab immediately beneath rather than behind.
 *
 * The previous version put both doors side by side over images with a scrim.
 * A scrim flattens a photograph to make room for text — which is the wrong
 * trade when the photographs are the product. Here the type owns one screen
 * and the image owns the next, so neither is compromised.
 */
---

<section class="hero screen">
  <div class="shell hero__inner">
    <p class="label hero__label">Wedding &amp; event planning — Slovenia</p>

    <h1 class="hero__line d-display">
      <span class="hero__l1">You get</span>
      <span class="hero__l2 flare">married.</span>
      <span class="hero__l3">I run the day.</span>
    </h1>

    <div class="hero__foot">
      <p class="hero__blurb">
        {site.weddingsPlanned} weddings, and the proposals, showers and parties around them.
        Slovenian, English, German.
      </p>
      <div class="hero__actions">
        <a class="btn" href={url('/enquire/')}>Check your date</a>
        <a class="textlink" href={url('/weddings/')}>How it works</a>
      </div>
    </div>
  </div>
</section>

<!-- The photograph gets its own screen, uncompromised: no scrim, no text. -->
<figure class="slab">
  <Pic
    src={heroWide}
    alt="Karin releasing a bride's veil into the wind on a terrace above Lake Bled"
    widths={[900, 1400, 2000]}
    sizes="100vw"
    priority
  />
  <figcaption class="slab__cap">
    <span>Above Lake Bled</span>
    <span>Full planning</span>
  </figcaption>
</figure>

<style>
  .hero { position: relative; }

  .hero__inner { width: 100%; }

  .hero__label { max-width: 40ch; }

  .hero__line {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    /* 0.78 packs the block but Anton's caps are tall enough that the lines
       collide and eat each other's letterforms. 0.86 keeps it architectural
       and still legible. */
    line-height: 0.86;
  }

  /* Deliberate asymmetry: each line sits at a different indent so the block
     reads as composed rather than as three centred rows. */
  .hero__l2 { margin-left: clamp(0rem, 6vw, 5rem); }
  .hero__l3 { font-size: 0.62em; margin-top: 0.12em; }

  .hero__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 4rem);
    flex-wrap: wrap;
    border-top: 1px solid var(--quiet);
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
  }

  .hero__blurb {
    margin: 0;
    max-width: 40ch;
    color: var(--ink-soft);
    font-size: var(--t-cap);
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    flex-wrap: wrap;
  }

  /* ── Full-bleed photograph ────────────────────────────── */
  .slab {
    margin: 0;
    position: relative;
    height: 92svh;
    overflow: hidden;
  }

  .slab :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slab__cap {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: var(--gutter);
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--canvas);
    text-shadow: 0 1px 12px rgb(20 37 46 / 0.55);
  }

  @media (max-width: 700px) {
    .slab { height: 68svh; }
  }
</style>
