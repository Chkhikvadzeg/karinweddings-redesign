---
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;

const links = [
  { href: url('/weddings/'), label: 'Weddings' },
  { href: url('/events/'), label: 'Events' },
  { href: url('/portfolio/'), label: 'Portfolio' },
  { href: url('/#organise'), label: 'What I organise' },
  { href: url('/#about'), label: 'About Karin' },
  { href: url('/enquire/'), label: 'Check your date' },
];
---

<!--
  Two dots, no nav bar.

  The reference strips navigation to two circles in opposite corners so the
  canvas stays empty for type. Same idea here, with one difference that
  matters: a real <dialog>-less disclosure rather than a decorative widget —
  the menu is keyboard-operable, focus-trapped by aria, and Escape closes it.
-->
<header class:list={['dots', { 'dots--overlay': overlay }]} data-nav>
  <button
    type="button"
    class="dot dot--menu"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-toggle
  >
    <span class="dot__bars" aria-hidden="true"><i></i><i></i></span>
    <span class="sr-only">Open menu</span>
  </button>

  <a class="dot dot--mark" href={url('/')} aria-label={`${site.name} — home`}>
    <span class="dot__k" aria-hidden="true">K</span>
  </a>
</header>

<nav class="menu" id="site-menu" aria-label="Primary" hidden data-menu>
  <ul class="menu__list">
    {links.map((l, i) => (
      <li style={`--i:${i}`}><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
  <p class="menu__foot">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
  </p>
</nav>

<style>
  .dots {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 120;
    display: flex;
    justify-content: space-between;
    padding: var(--gutter);
    pointer-events: none;
  }

  .dot {
    pointer-events: auto;
    width: 50px;
    height: 50px;
    border-radius: var(--r-pill);
    background: var(--flare-deep);
    color: var(--canvas);
    border: 0;
    display: grid;
    place-items: center;
    cursor: pointer;
    text-decoration: none;
    transition: transform var(--m-state) var(--ease), background var(--m-state) var(--ease);
  }

  .dot:hover { transform: scale(1.08); }

  .dot__bars { display: grid; gap: 5px; }
  .dot__bars i {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform var(--m-state) var(--ease), opacity var(--m-state) var(--ease);
  }

  .dots.is-open .dot--menu { background: var(--ink); }
  .dots.is-open .dot__bars i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .dots.is-open .dot__bars i:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .dot__k {
    font-family: var(--display);
    font-size: 1.5rem;
    line-height: 1;
    padding-top: 2px;
  }

  /* ── Menu ─────────────────────────────────────────────── */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 110;
    background: var(--canvas);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--gutter) * 2) var(--gutter);
  }

  .menu[hidden] { display: none; }

  .menu__list {
    list-style: none;
    margin: 0 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
  }

  .menu__list a {
    font-family: var(--display);
    text-transform: uppercase;
    font-size: clamp(2.25rem, 8vw, 5.5rem);
    line-height: 0.95;
    text-decoration: none;
    display: inline-block;
    transition: color var(--m-state) var(--ease), transform var(--m-state) var(--ease);
  }

  .menu__list a:hover { color: var(--flare); transform: translateX(0.5rem); }

  /* Staggered entrance — one orchestrated moment, not scattered effects. */
  .menu.is-open .menu__list li {
    animation: menu-in var(--m-move) var(--ease-enter) both;
    animation-delay: calc(var(--i) * 55ms);
  }

  @keyframes menu-in {
    from { opacity: 0; transform: translateY(1.25rem); }
    to { opacity: 1; transform: none; }
  }

  .menu__foot {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin: 0;
    font-size: var(--t-cap);
    color: var(--ink-soft);
  }

  .menu__foot a { text-decoration: none; }
  .menu__foot a:hover { color: var(--flare); }

  @media (prefers-reduced-motion: reduce) {
    .menu.is-open .menu__list li { animation: none; }
  }
</style>

<script>
  function initMenu() {
    const bar = document.querySelector<HTMLElement>('[data-nav]');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!bar || !btn || !menu) return;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      menu.classList.toggle('is-open', open);
      bar.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector('a')?.focus();
    };

    btn.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }

  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>
