---
import { process } from '../data/process';
import { url } from '../lib/url';

/**
 * The process spine.
 *
 * Desktop: a horizontal scroll-snapping rail with a continuous line running
 * through it — the timeline reads as one object rather than six cards.
 * Mobile: the same steps as a vertical list against the same line.
 *
 * No JS. Scroll snapping, sticky positioning and a pseudo-element rule do all
 * of it, so it degrades to a plain readable list if anything fails.
 */
---

<section class="band band--deep spine" id="process">
  <div class="shell">
    <header class="spine__head" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2 class="spine__title">What you actually have to do</h2>
      <p class="lead">
        Almost nothing, is the honest answer. Here is the whole thing, from the first call to the
        week after — and what is asked of you at each stage.
      </p>
    </header>
  </div>

  <ol class="spine__rail" data-reveal data-reveal-delay="120">
    {
      process.map((step, i) => (
        <li class="step">
          <div class="step__marker" aria-hidden="true">
            <span class="step__dot" />
          </div>
          <img
            class="step__icon"
            src={url(`/icons/${step.icon}`)}
            alt=""
            width="52"
            height="52"
            loading="lazy"
          />
          <p class="step__when">{step.when}</p>
          <h3 class="step__title">
            <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
            {step.title}
          </h3>
          <p class="step__body">{step.body}</p>
          <p class="step__yours">
            <span class="step__yoursLabel">Your part</span>
            {step.yours}
          </p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .spine__head {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .spine__title {
    font-size: var(--fs-display);
    margin-bottom: 1.25rem;
  }

  .spine__rail {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter) 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(17rem, 21rem);
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Without this the snap engine aligns step 01 to the scroll-start edge and
       silently cancels the padding-inline — the rail loads scrolled 72px right
       and the first step sits flush against the viewport edge. */
    scroll-padding-inline: var(--gutter);
    /* Firefox + fallback; the WebKit bar is styled below */
    scrollbar-width: thin;
    scrollbar-color: var(--clay) transparent;
  }

  .spine__rail::-webkit-scrollbar {
    height: 3px;
  }

  .spine__rail::-webkit-scrollbar-track {
    background: var(--rule);
  }

  .spine__rail::-webkit-scrollbar-thumb {
    background: var(--clay);
  }

  .step {
    position: relative;
    scroll-snap-align: start;
    padding-top: 2.5rem;
  }

  /* The continuous line. Drawn per-step and butted together so it survives
     horizontal scrolling without a separate absolutely-positioned track. */
  .step__marker {
    position: absolute;
    top: 0.5rem;
    left: 0;
    right: calc(clamp(1.25rem, 2.5vw, 2.25rem) * -1);
    height: 1px;
    background: var(--rule);
  }

  .step:last-child .step__marker {
    right: 0;
  }

  .step__dot {
    position: absolute;
    left: 0;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--terracotta);
  }

  .step:first-child .step__dot {
    background: var(--terracotta);
  }

  .step__icon {
    width: 52px;
    height: 52px;
    margin-bottom: 0.9rem;
    opacity: 0.9;
  }

  .step__when {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 0 0 0.6rem;
    font-weight: 600;
  }

  .step__title {
    font-size: 1.375rem;
    line-height: 1.2;
    margin-bottom: 0.85rem;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .step__num {
    font-family: var(--sans);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .step__body {
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--ink-soft);
    margin-bottom: 1.1rem;
  }

  .step__yours {
    margin: 0;
    padding: 0.85rem 1rem;
    background: var(--paper);
    border-left: 2px solid var(--clay);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .step__yoursLabel {
    display: block;
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.25rem;
    font-weight: 600;
  }

  /* Vertical on small screens — a horizontal rail on a phone is a
     discoverability problem, not a feature. */
  @media (max-width: 780px) {
    .spine__rail {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      overflow-x: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
      gap: 0;
    }

    .step {
      padding: 0 0 2rem 1.75rem;
    }

    .step__marker {
      top: 0.55rem;
      bottom: -0.5rem;
      left: 0;
      right: auto;
      width: 1px;
      height: auto;
    }

    .step:last-child .step__marker {
      bottom: auto;
      height: 0;
    }

    .step__dot {
      top: 0;
      margin-top: 0;
      left: -4px;
    }
  }
</style>
