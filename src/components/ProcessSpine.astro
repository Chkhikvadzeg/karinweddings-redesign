---
import { process } from '../data/process';
import { url } from '../lib/url';

/**
 * The signature element: the ledger.
 *
 * Every review Karin has says the same thing — she takes the work away. The
 * ledger argues that visually rather than claiming it. Two columns run the
 * length of the page: what she does, and what the couple does. Her side is
 * dense. Theirs is nearly empty, and gets emptier, ending at "Nothing."
 *
 * The whitespace in the right-hand column IS the pitch. That is why this page
 * is laid out this way and not as cards.
 *
 * Numbering is kept here and nowhere else on the site, because this is the one
 * piece of content that genuinely is a sequence — the order carries meaning a
 * reader needs.
 */
---

<section class="band band--deep ledger" id="process">
  <div class="shell">
    <header class="ledger__head" data-reveal>
      <p class="eyebrow">From the first call to the week after</p>
      <h2 class="ledger__title">What I do.<br /><span class="script">What you do.</span></h2>
      <p class="lead">
        The right-hand column is the whole point. Read down it and see how little of your own
        wedding you are asked to carry.
      </p>
    </header>

    <div class="ledger__table">
      <div class="ledger__colhead" aria-hidden="true">
        <span>Mine</span>
        <span>Yours</span>
      </div>

      <ol class="ledger__rows">
        {
          process.map((step, i) => (
            <li class="row" data-reveal data-reveal-delay={i * 90}>
              <span class="row__when">{step.when}</span>

              <div class="row__mine">
                <h3 class="row__title">
                  <span class="row__num">{String(i + 1).padStart(2, '0')}</span>
                  {step.title}
                </h3>
                <p class="row__body">{step.body}</p>
              </div>

              <div class="row__yours">
                <p class="row__yoursText">{step.yours}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="ledger__foot" data-reveal>
      <a class="textlink" href={url('/enquire/')}>Start with the first call →</a>
    </p>
  </div>
</section>

<style>
  .ledger__head {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .ledger__title {
    font-size: var(--fs-display);
    margin-bottom: 1.5rem;
  }

  .ledger__title .script {
    color: var(--lake);
  }

  /* ── Column headings ──────────────────────────────────────── */
  .ledger__colhead {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--ink);
  }

  .ledger__colhead span {
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .ledger__colhead span:first-child {
    grid-column: 2;
  }

  .ledger__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }

  .row__when {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lake);
    padding-top: 0.35rem;
  }

  .row__title {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.15;
    margin-bottom: 0.7rem;
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
  }

  .row__num {
    font-family: var(--sans);
    font-size: 0.6875rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    flex: none;
  }

  .row__body {
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--ink-soft);
    margin: 0;
    max-width: 38rem;
  }

  /* The couple's column: one short line, wide margins, deliberately airy.
     A vertical hairline separates it so the emptiness reads as a column
     rather than as a gap. */
  .row__yours {
    border-left: 1px solid var(--rule);
    padding-left: clamp(1.25rem, 2.5vw, 2rem);
    min-height: 3rem;
  }

  .row__yoursText {
    font-family: var(--display);
    font-size: clamp(1.0625rem, 1.6vw, 1.375rem);
    line-height: 1.35;
    margin: 0;
  }

  /* The last row is the payoff — "Nothing." gets the emphasis. */
  .row:last-child .row__yoursText {
    font-style: italic;
    color: var(--lake);
    font-size: clamp(1.375rem, 2.4vw, 2rem);
  }

  .ledger__foot {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  @media (max-width: 860px) {
    .ledger__colhead {
      display: none;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding-block: 1.5rem;
    }

    .row__yours {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-left: 0;
      padding-top: 0.85rem;
      min-height: 0;
    }

    /* Label the column on small screens, where the two-column
       relationship is no longer visible. */
    .row__yours::before {
      content: 'Your part';
      display: block;
      font-family: var(--sans);
      font-size: 0.5625rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 0.3rem;
    }
  }
</style>
