---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Every image on the site goes through here.
 *
 * Two reasons it exists rather than calling <Image> directly:
 *
 * 1. Quality. Astro's sharp service defaults to quality 80, which for AVIF
 *    produces files *larger than the source JPEG* on photographic content.
 *    AVIF at ~48 is visually indistinguishable at these sizes and roughly an
 *    order of magnitude smaller. Setting it in one place means nobody has to
 *    remember.
 *
 * 2. `alt` is required by the type signature. Decorative images must opt out
 *    explicitly with decorative={true}, which is how you avoid shipping the
 *    five missing alt attributes the live site currently has.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** Decorative images pass alt="" — must be deliberate, not an oversight */
  decorative?: boolean;
  widths?: number[];
  sizes: string;
  priority?: boolean;
  quality?: number;
  class?: string;
}

const {
  src,
  alt,
  decorative = false,
  widths = [480, 800, 1200],
  sizes,
  priority = false,
  quality = 48,
  class: className,
} = Astro.props;

if (!decorative && !alt) {
  throw new Error('Pic: alt text is required. Pass decorative={true} for presentational images.');
}

// Never upscale past the source.
const capped = [...new Set(widths.filter((w) => w <= src.width).concat(Math.min(src.width, Math.max(...widths))))].sort(
  (a, b) => a - b
);
---

<Image
  src={src}
  alt={decorative ? '' : alt}
  widths={capped}
  sizes={sizes}
  format="avif"
  quality={quality}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={className}
/>
