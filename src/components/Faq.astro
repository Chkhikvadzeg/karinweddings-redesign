---
import { faqs } from '../data/site';

// Native <details>: keyboard-accessible for free and still usable if
// scripting fails. Emits FAQPage schema for rich results.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section faq">
  <div class="shell faq__shell">
    <div class="faq__aside" data-reveal>
      <p class="eyebrow">Before you ask</p>
      <h2 class="faq__title">The things everyone asks</h2>
    </div>

    <div class="faq__list" data-reveal data-reveal-delay="120">
      {
        faqs.map((f) => (
          <details class="faq__item">
            <summary>
              <span>{f.q}</span>
              <span class="faq__sign" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq__shell {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .faq__title {
    font-size: var(--fs-title);
    max-width: 16ch;
  }

  .faq__item {
    border-top: 1px solid var(--rule);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--display);
    font-size: 1.1875rem;
    line-height: 1.3;
    min-height: 48px;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__sign {
    flex: none;
    width: 13px;
    height: 13px;
    position: relative;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    background: var(--terracotta);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  .faq__sign::before {
    inset: 6px 0 auto 0;
    height: 1.5px;
  }

  .faq__sign::after {
    inset: 0 6px auto auto;
    width: 1.5px;
    height: 13px;
  }

  .faq__item[open] .faq__sign::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  .faq__answer {
    padding-bottom: 1.5rem;
    max-width: 48ch;
  }

  .faq__answer p {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .faq__shell {
      grid-template-columns: 1fr;
    }
  }
</style>
